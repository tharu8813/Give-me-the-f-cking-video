<Window x:Class="GMTFV.Wpf.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="다운로드 설정" Width="720" Height="590" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="다운로드 설정" FontSize="24" FontWeight="Bold"/><TextBlock Text="저장 방식과 성능 옵션을 내 환경에 맞게 조정하세요." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        <TabControl Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10"><TabItem Header="기본"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="저장 폴더" FontWeight="SemiBold"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="내 PC\다운로드" Height="42" VerticalContentAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="찾아보기" Margin="10,0,0,0"/></Grid></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="저장 형식" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><RadioButton Content="비디오 (MP4)" IsChecked="True" Margin="0,0,24,0"/><RadioButton Content="오디오 (MP3)"/></StackPanel></StackPanel><StackPanel Grid.Row="4"><TextBlock Text="파일 이름" FontWeight="SemiBold"/><TextBox Text="%title%_%date%" Margin="0,10,0,0" Height="42" VerticalContentAlignment="Center"/><TextBlock Text="미리보기  ·  영상제목_2026-08-13.mp4" Foreground="#6EE7B7" Margin="0,8,0,0"/></StackPanel></Grid></TabItem><TabItem Header="성능"><StackPanel Margin="24"><TextBlock Text="동시 다운로드" FontWeight="SemiBold"/><Slider Minimum="1" Maximum="5" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,8"/><TextBlock Text="네트워크 환경에 따라 1~3개를 권장합니다." Foreground="{StaticResource MutedBrush}"/><TextBlock Text="오디오 품질" FontWeight="SemiBold" Margin="0,28,0,10"/><ComboBox SelectedIndex="1"><ComboBoxItem Content="128 kbps · 일반"/><ComboBoxItem Content="192 kbps · 고품질"/><ComboBoxItem Content="320 kbps · 최고"/></ComboBox></StackPanel></TabItem></TabControl>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="기본값 복원" Margin="0,0,10,0"/><Button Style="{StaticResource PrimaryButton}" Content="변경사항 저장" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
