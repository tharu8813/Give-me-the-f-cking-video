<Window x:Class="GMTFV.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:GMTFV.Wpf.Behaviors"
        Title="다운로드 설정"
        Width="680" Height="720" MinWidth="600" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Brush.Canvas}">
    <Grid Margin="28,24,28,22" Background="{StaticResource Brush.Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="다운로드 설정" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0" Text="저장 위치와 출력 품질의 기본값을 관리합니다." Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                <TextBlock Text="다음 작업부터 적용" FontSize="11" Foreground="{StaticResource Brush.Primary}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel>
                <Border Padding="20" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="저장 위치" Style="{StaticResource SectionTitle}" />
                        <TextBlock Margin="0,5,0,12" Text="완료된 영상과 오디오가 저장될 폴더입니다." Style="{StaticResource CaptionText}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click">폴더 선택</Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="20" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="출력 형식" Style="{StaticResource SectionTitle}" />
                        <TextBlock Margin="0,5,0,14" Text="영상 또는 오디오를 선택하고 원하는 파일 형식을 지정하세요." Style="{StaticResource CaptionText}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="콘텐츠 유형" Style="{StaticResource CaptionText}" />
                                <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                    <RadioButton x:Name="VideoRadio" GroupName="OutputType" Content="영상" Click="VideoRadio_Click" />
                                    <RadioButton x:Name="AudioRadio" GroupName="OutputType" Margin="22,0,0,0" Content="오디오" Click="AudioRadio_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="파일 형식" Style="{StaticResource CaptionText}" />
                                <ComboBox x:Name="ContainerComboBox" Margin="0,6,0,0" SelectedItem="{Binding Container, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,20,0,0" Text="파일명 형식" FontWeight="SemiBold" />
                        <TextBox Margin="0,7,0,0" Style="{StaticResource InputBox}" Text="{Binding FileNameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="1,7,0,0" Text="사용 가능: %title%  %author%  %date%  %id%  %num%  %ext%" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="20" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="성능 및 품질" Style="{StaticResource SectionTitle}" />
                        <TextBlock Margin="0,5,0,14" Text="동시 작업이 많을수록 시스템과 네트워크 사용량이 증가합니다." Style="{StaticResource CaptionText}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GPU 가속" Style="{StaticResource CaptionText}" />
                                <ComboBox Margin="0,6,0,0" SelectedValuePath="Content" SelectedValue="{Binding GpuAccelerator, Mode=TwoWay}">
                                    <ComboBoxItem Content="CPU" /><ComboBoxItem Content="NVIDIA" /><ComboBoxItem Content="AMD" /><ComboBoxItem Content="Intel" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="동시 다운로드 (1~5)" Style="{StaticResource CaptionText}" />
                                <TextBox x:Name="MaxConcurrentDownloadsTextBox" Margin="0,6,0,0" Style="{StaticResource InputBox}" Text="{Binding MaxConcurrentDownloads, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,18,0,0" Text="오디오 비트레이트 (32~512 kbps)" Style="{StaticResource CaptionText}" />
                        <TextBox x:Name="AudioBitrateTextBox" Margin="0,6,0,0" Width="180" HorizontalAlignment="Left" Style="{StaticResource InputBox}" Text="{Binding AudioBitrate, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <TextBlock Text="설정은 이 창에서 저장을 눌러야 적용됩니다." VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click">취소</Button>
                <Button Margin="10,0,0,0" MinWidth="96" Style="{StaticResource PrimaryButton}" Click="Save_Click">설정 저장</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
