<Window x:Class="GMTFV.Wpf.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GMTFV.Wpf.Views" xmlns:s="clr-namespace:GMTFV.Wpf.Services"
 Title="GMTFV" Icon="/GMTFV.Wpf;component/Assets/App.ico" Width="1180" Height="720" MinWidth="900" MinHeight="600" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource BodyFont}" WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDrop="WindowDrop" PreviewDragOver="WindowDragOver" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">


 <Grid Background="{DynamicResource BackgroundBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="12,22">
    <Image DockPanel.Dock="Top" Source="/GMTFV.Wpf;component/Assets/App.ico" Width="44" Height="44" Margin="0,0,0,36" AutomationProperties.Name="GMTFV 아이콘" />
    <StackPanel DockPanel.Dock="Bottom"><Button Content="?" Style="{StaticResource IconButton}" Command="{Binding PanelCommand}" CommandParameter="About" ToolTip="GMTFV 정보" AutomationProperties.Name="앱 정보" /></StackPanel>
    <StackPanel><Button Content="⚙" Style="{StaticResource IconButton}" Command="{Binding PanelCommand}" CommandParameter="Settings" ToolTip="설정" AutomationProperties.Name="설정" Margin="0,12,0,0" /><Button Content="⌁" Style="{StaticResource IconButton}" Command="{Binding PanelCommand}" CommandParameter="Diagnostics" ToolTip="도구 및 진단" AutomationProperties.Name="도구 및 진단" Margin="0,12,0,0" /></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="{StaticResource PagePadding}" IsEnabled="{Binding IsWorkspaceEnabled}" s:Motion.Enter="True">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="GMTFV" FontSize="24" FontWeight="Bold" /></StackPanel><Button Grid.Column="1" Content="저장 폴더 ↗" Command="{Binding OpenOutputCommand}" VerticalAlignment="Top" /></Grid>
   <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="YouTube URL 추가" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" /><TextBlock Grid.Column="2" Text="여러 주소도 한 번에" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
     <TextBox x:Name="UrlBox" Grid.Row="1" Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="44" MaxHeight="72" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" AutomationProperties.Name="YouTube URL 입력" ToolTip="YouTube URL을 줄바꿈으로 구분하여 붙여넣으세요. Enter: 추가 / Shift+Enter: 줄바꿈" />
     <TextBlock Grid.Row="1" Text="YouTube URL 붙여넣기 / 드래그 앤 드롭" Foreground="{DynamicResource DisabledBrush}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UrlInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Button Grid.Column="2" Grid.Row="1" Content="+  큐에 추가" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="다운로드 큐" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding Items.Count, StringFormat=  /  {0:D2}}" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="8,0,0,0" /></StackPanel><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,7,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="목록 열기" Command="{Binding LoadListCommand}" /><Button Content="목록 저장" Command="{Binding SaveListCommand}" Margin="8,0,0,0" /><Button Content="실패 재시도" Command="{Binding RetryFailedCommand}" Margin="8,0,0,0" /></StackPanel></Grid>
   <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><local:QueueView /></Border>
   <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,30,0"><StackPanel Orientation="Horizontal"><TextBlock Text="SESSION" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding CompletedCount, StringFormat=  완료 {0}개}" Style="{StaticResource Caption}" Margin="12,0,0,8" /><TextBlock Text="{Binding FailedCount, StringFormat=  실패 {0}개}" Margin="12,0,0,0" Foreground="{DynamicResource ErrorBrush}" FontSize="12" /></StackPanel><ProgressBar s:Motion.Progress="{Binding OverallProgress}" AutomationProperties.Name="전체 큐 진행률" /><Button Content="{Binding SelectedFormat}" ContentStringFormat="빠른 설정 · {0} / 화질 · 저장 위치 →" Command="{Binding PanelCommand}" CommandParameter="Settings" HorizontalAlignment="Left" MinHeight="30" Padding="0,6" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="전체 취소" Command="{Binding CancelAllCommand}" Margin="0,0,10,0" /><Button Content="↓  다운로드 시작" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Padding="24,14" /></StackPanel></Grid>
  </Grid>
  <Grid x:Name="PanelOverlay" Grid.Column="1" s:Motion.Present="{Binding HasPanel}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="ClosePanel" />
   <Border HorizontalAlignment="Right" Width="460" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="24">
    <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,24"><TextBlock Text="{Binding PanelTitle}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /><Button Content="×" Command="{Binding PanelCommand}" CommandParameter="" Style="{StaticResource IconButton}" HorizontalAlignment="Right" AutomationProperties.Name="패널 닫기" /></Grid><ContentControl x:Name="PanelContent"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding DisplayedPanel}" Value="Settings"><Setter Property="Content"><Setter.Value><local:SettingsView /></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding DisplayedPanel}" Value="Diagnostics"><Setter Property="Content"><Setter.Value><local:DiagnosticsView /></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding DisplayedPanel}" Value="About"><Setter Property="Content"><Setter.Value><local:AboutView /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></DockPanel>
   </Border>
  </Grid>
  <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30,0,30,110" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="20,13" MaxWidth="740" s:Motion.Present="{Binding Toast, Converter={StaticResource HasValue}}" IsHitTestVisible="False"><TextBlock Text="{Binding Toast}" Foreground="{DynamicResource AccentInkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" /></Border>
  <Grid x:Name="ItemOverlay" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" s:Motion.Present="{Binding ItemSettings, Converter={StaticResource HasValue}}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Width="620" Margin="24" Padding="24"><local:ItemSettingsView DataContext="{Binding DisplayedItemSettings}" /></Border>
  </Grid>
  <Grid x:Name="FailureOverlay" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" s:Motion.Present="{Binding Failure, Converter={StaticResource HasValue}}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Width="570" MaxHeight="540" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="DOWNLOAD INTERRUPTED" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource ErrorBrush}" /><TextBlock Text="다운로드 실패 상세" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,8" /><TextBlock Text="{Binding Failure.Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" Margin="0,0,0,20" /></StackPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="로그 열기" Command="{Binding OpenLogsCommand}" /><Button Content="닫기" Click="CloseFailure" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" /></StackPanel><ScrollViewer><TextBox Text="{Binding Failure.Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" /></ScrollViewer></DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
