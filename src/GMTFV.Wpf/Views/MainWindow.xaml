<Window x:Class="GMTFV.Wpf.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GMTFV.Wpf.Views" xmlns:s="clr-namespace:GMTFV.Wpf.Services"
 Title="GMTFV" Icon="/GMTFV.Wpf;component/Assets/App.ico" Width="1220" Height="800" MinWidth="900" MinHeight="660" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource BodyFont}" FontSize="13" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDrop="WindowDrop" PreviewDragOver="WindowDragOver" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
 <Grid Background="{DynamicResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
   <Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="/GMTFV.Wpf;component/Assets/App.png" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="GMTFV 아이콘" />
     <TextBlock Text="GMTFV" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" /><Border Width="1" Height="20" Background="{DynamicResource LineBrush}" Margin="20,0" /><TextBlock Text="미디어 작업 공간" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Content="설정" Style="{StaticResource QuietButton}" Command="{Binding PanelCommand}" CommandParameter="Settings" />
     <Button Content="도구 및 진단" Style="{StaticResource QuietButton}" Command="{Binding PanelCommand}" CommandParameter="Diagnostics" Margin="4,0" />
     <Button Content="{Binding Updates.UpdateLabel}" Style="{StaticResource QuietButton}" Command="{Binding PanelCommand}" CommandParameter="About" />
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="{StaticResource PagePadding}" IsEnabled="{Binding IsWorkspaceEnabled}" s:Motion.Depth="{Binding HasPanel}">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="{DynamicResource PanelBrush}" CornerRadius="{StaticResource SurfaceRadius}" Padding="16,12,16,14">
    <StackPanel>
     <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="저장할 영상의 링크를 넣어주세요" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" IsEnabled="{Binding CanEditSettings}"><RadioButton Content="영상 다운로드" GroupName="QuickMode" MinHeight="24" Padding="8,2" IsChecked="{Binding Settings.IsVideo, Converter={StaticResource ModeRadio}, ConverterParameter=Video}" AutomationProperties.Name="영상 다운로드" /><RadioButton Content="오디오만 다운로드" GroupName="QuickMode" MinHeight="24" Padding="8,2" IsChecked="{Binding Settings.IsVideo, Converter={StaticResource ModeRadio}, ConverterParameter=Audio}" AutomationProperties.Name="오디오만 다운로드" /></StackPanel>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
      <TextBox x:Name="UrlBox" Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="44" MaxHeight="72" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" AutomationProperties.Name="YouTube URL 입력" ToolTip="Enter: 추가 / Shift+Enter: 줄바꿈 · 여러 링크와 목록 파일 드롭 지원" />
      <TextBlock Text="YouTube 링크 붙여넣기" Foreground="{DynamicResource DisabledBrush}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UrlInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" AutomationProperties.Name="영상 추가"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Add}" Style="{StaticResource VectorIcon}" Margin="0,0,8,0" /><TextBlock Text="영상 추가" /></StackPanel></Button>
     </Grid>
     <Grid Margin="0,12,0,0" IsEnabled="{Binding CanEditSettings}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="126" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding FormatChoices}" SelectedValuePath="Id" SelectedValue="{Binding SelectedFormat}" ItemTemplate="{StaticResource FormatTemplate}" ToolTip="{Binding FormatDescription}" Margin="0,0,8,0" AutomationProperties.Name="기본 저장 형식" />
      <Grid Grid.Column="1" Margin="0,0,12,0"><ComboBox ItemsSource="{Binding Heights}" SelectedItem="{Binding SelectedHeight}" Visibility="{Binding Settings.IsVideo, Converter={StaticResource BoolVisibility}}" ItemTemplate="{StaticResource QualityTemplate}" AutomationProperties.Name="기본 화질" /><ComboBox ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding Settings.AudioBitrate}" AutomationProperties.Name="변환 시 비트레이트" IsEnabled="{Binding CanSetBitrate}" ToolTip="{Binding BitrateHint}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Settings.IsVideo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} kbps}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
      <Button Grid.Column="2" Command="{Binding ChooseOutputCommand}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="8,6" ToolTip="{Binding Settings.OutputFolder}" AutomationProperties.Name="저장 위치 선택"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource VectorIcon}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding Settings.OutputFolder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid></Button>
      <Button Grid.Column="3" Content="고급 설정" Command="{Binding PanelCommand}" CommandParameter="Settings" Style="{StaticResource QuietButton}" Padding="12,6" />
     </Grid>
    </StackPanel>
   </Border>
   <local:QueueView Grid.Row="1" Grid.RowSpan="2" />
   <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><Grid><TextBlock Text="{Binding CompletionSummary}" FontWeight="SemiBold" /><TextBlock Text="{Binding FailedCount, StringFormat=실패 {0}개}" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding FailedCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ProgressBar s:Motion.Progress="{Binding OverallProgress}" Margin="0,10,0,8" AutomationProperties.Name="전체 항목 중 저장 완료 비율" /><DockPanel><Button DockPanel.Dock="Right" Content="목록 작업 취소" Command="{Binding CancelListCommand}" Style="{StaticResource QuietButton}" Padding="4,0" MinHeight="18" Visibility="{Binding IsListBusy, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{Binding WorkspaceStatus}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" /></DockPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="전체 취소" Command="{Binding CancelAllCommand}" Style="{StaticResource QuietButton}" Margin="0,0,12,0" /><Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Padding="24,16" AutomationProperties.Name="다운로드 시작"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Download}" Style="{StaticResource VectorIcon}" Margin="0,0,10,0" /><TextBlock Text="다운로드 시작" FontSize="14" /></StackPanel></Button></StackPanel>
   </Grid>
  </Grid>
  <Grid x:Name="PanelOverlay" s:Motion.Kind="Scrim" Grid.RowSpan="2" s:Motion.Present="{Binding HasPanel}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="ClosePanel" />
   <Border s:Motion.Present="{Binding HasPanel}" s:Motion.Kind="Sheet" HorizontalAlignment="Right" Width="500" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="24">
    <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,24"><TextBlock Text="{Binding PanelTitle}" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" /><Button Content="닫기" Command="{Binding PanelCommand}" CommandParameter="" HorizontalAlignment="Right" AutomationProperties.Name="패널 닫기" /></Grid><ContentControl x:Name="PanelContent"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding DisplayedPanel}" Value="Settings"><Setter Property="Content"><Setter.Value><local:SettingsView /></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding DisplayedPanel}" Value="Diagnostics"><Setter Property="Content"><Setter.Value><local:DiagnosticsView /></Setter.Value></Setter></DataTrigger><DataTrigger Binding="{Binding DisplayedPanel}" Value="About"><Setter Property="Content"><Setter.Value><local:AboutView /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></DockPanel>
   </Border>
  </Grid>
  <Border Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="30,0,30,110" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="20,13" MaxWidth="740" s:Motion.Present="{Binding Toast, Converter={StaticResource HasValue}}" IsHitTestVisible="False"><TextBlock Text="{Binding Toast}" Foreground="{DynamicResource AccentInkBrush}" TextWrapping="Wrap" FontWeight="SemiBold" /></Border>
  <Grid x:Name="ItemOverlay" s:Motion.Kind="Scrim" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" s:Motion.Present="{Binding ItemSettings, Converter={StaticResource HasValue}}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" s:Motion.Present="{Binding ItemSettings, Converter={StaticResource HasValue}}" s:Motion.Kind="Sheet" CornerRadius="{StaticResource SurfaceRadius}" HorizontalAlignment="Right" Width="620" Margin="16" Padding="24"><local:ItemSettingsView DataContext="{Binding DisplayedItemSettings}" /></Border>
  </Grid>
  <Grid x:Name="FailureOverlay" s:Motion.Kind="Scrim" Grid.RowSpan="2" Background="{DynamicResource ScrimBrush}" s:Motion.Present="{Binding Failure, Converter={StaticResource HasValue}}" KeyboardNavigation.TabNavigation="Cycle">
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" s:Motion.Present="{Binding Failure, Converter={StaticResource HasValue}}" s:Motion.Kind="Modal" CornerRadius="{StaticResource SurfaceRadius}" Width="570" MaxHeight="540" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="작업을 계속할 수 있도록" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource ErrorBrush}" />
      <TextBlock Text="{Binding Failure.ErrorTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,12" />
      <TextBlock Text="{Binding Failure.Title}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,0,20" />
      <TextBlock Text="{Binding Failure.ErrorAction}" TextWrapping="Wrap" LineHeight="23" />
     </StackPanel>
     <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="도구 확인" Command="{Binding PanelCommand}" CommandParameter="Diagnostics" Click="CloseFailure" />
      <Button Content="다시 시도" Command="{Binding RetryCommand}" CommandParameter="{Binding Failure}" Click="RetryFailure" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" ToolTip="진행 중인 다운로드를 마친 뒤 다시 시도할 수 있습니다." />
      <Button Content="닫기" Click="CloseFailure" Margin="8,0,0,0" />
     </WrapPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><Expander Header="기술 상세 보기"><TextBox Text="{Binding Failure.Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,10,0,0" /></Expander></ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
