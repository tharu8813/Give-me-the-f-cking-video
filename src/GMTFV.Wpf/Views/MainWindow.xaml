<Window x:Class="GMTFV.Wpf.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:model="clr-namespace:GMTFV.Wpf.Models" Title="GMTFV" Width="1240" Height="780" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type model:DownloadItem}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#26345A" VerticalAlignment="Top"><TextBlock Text="▶" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDB2FF"/></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Channel}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/><ProgressBar Height="4" Margin="0,12,0,0" Maximum="100" Value="{Binding Progress}" Visibility="Collapsed"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Format}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Duration}" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#1C3B3A" CornerRadius="8" Padding="9,5" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Foreground="#6EE7B7" FontWeight="SemiBold"/></Border><Button Style="{StaticResource GhostButton}" Content="옵션" Padding="10,6" Margin="0,8,0,0" Click="Details_Click"/></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border Width="32" Height="32" Background="{StaticResource AccentBrush}" CornerRadius="10" Margin="0,0,10,0"><TextBlock Text="G" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="GMTFV" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="좋아하는 영상을 나만의 라이브러리로" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GhostButton}" Content="⚙ 설정" Margin="0,0,10,0" Click="Settings_Click"/><Button Style="{StaticResource SecondaryButton}" Content="◉ Chrome 탭" Margin="0,0,10,0" Click="Chrome_Click"/><Button Style="{StaticResource PrimaryButton}" Content="＋ 새 영상" Click="Add_Click"/></StackPanel></Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="다운로드 큐" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="저장할 영상을 추가하고, 준비가 되면 다운로드를 시작하세요." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding QueueSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl"><Border Background="#11182A" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✦" FontSize="34" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="아직 추가한 영상이 없습니다" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/><TextBlock Text="새 영상을 추가하거나 Chrome에 열어 둔 탭을 가져오세요." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ItemsControl.Style></ItemsControl></ScrollViewer></Grid></Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="준비됨" FontWeight="SemiBold"/><TextBlock Text="영상 정보를 가져오면 다운로드 형식과 품질을 선택할 수 있어요." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="다운로드 시작  →" VerticalAlignment="Center" Click="Download_Click"/></Grid></Border>
    </Grid>
</Window>
