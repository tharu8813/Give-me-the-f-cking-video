<Window x:Class="GMTFV.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:GMTFV.Wpf.Behaviors"
        Title="GMTFV WPF Preview · YouTube Downloader"
        Width="1240" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ItemsPanelTemplate x:Key="StackItemsPanel"><VirtualizingStackPanel /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridItemsPanel"><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate>

        <DataTemplate x:Key="DetailedItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="10" /><ColumnDefinition Width="72" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="185" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding QueueNumberText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Grid.Column="2" Width="72" Height="72" CornerRadius="10" Background="{StaticResource Brush.SurfaceMuted}" VerticalAlignment="Center" ClipToBounds="True"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" /></Border>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{Binding ChannelName}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="{Binding ProfileSummary}" FontSize="11" Foreground="{StaticResource Brush.Primary}" />
                    <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><ProgressBar Height="7" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" /><TextBlock Grid.Column="1" Text="{Binding ProgressText}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" /></Grid>
                </Grid>
                <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border MaxWidth="185" Style="{StaticResource StatusPill}"><TextBlock x:Name="DetailedStatus" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Brush.Primary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" /></Border>
                    <Grid Margin="0,8,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DownloadSpeedText}" Foreground="{StaticResource Brush.Warning}" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding DurationText}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" /></Grid>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMetadataLoading}" Value="True"><Setter TargetName="DetailedStatus" Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger>
                <DataTrigger Binding="{Binding HasMetadataError}" Value="True"><Setter TargetName="DetailedStatus" Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SimpleItemTemplate">
            <Grid Height="42">
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="205" /><ColumnDefinition Width="115" /><ColumnDefinition Width="120" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding QueueNumberText}" FontWeight="Bold" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" Text="{Binding ChannelName}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ProfileSummary}" Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding DownloadSpeedText}" Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SimpleStatus" Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                <TextBlock Grid.Column="5" Text="{Binding ProgressText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsMetadataLoading}" Value="True"><Setter TargetName="SimpleStatus" Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger><DataTrigger Binding="{Binding HasMetadataError}" Value="True"><Setter TargetName="SimpleStatus" Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="GridItemTemplate">
            <StackPanel Width="218">
                <Grid><Border Height="118" CornerRadius="9" Background="{StaticResource Brush.SurfaceMuted}" ClipToBounds="True"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" /></Border><Border Width="30" Height="30" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC0B1120" CornerRadius="8"><TextBlock Text="{Binding QueueNumberText}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                <TextBlock Margin="0,10,0,0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ProfileSummary}" FontSize="11" Foreground="{StaticResource Brush.Primary}" TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><ProgressBar Height="7" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" /><TextBlock Grid.Column="1" Text="{Binding ProgressText}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" /></Grid>
                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="GridStatus" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" /><TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" Foreground="{StaticResource Brush.Warning}" FontSize="11" /></Grid>
            </StackPanel>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsMetadataLoading}" Value="True"><Setter TargetName="GridStatus" Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger><DataTrigger Binding="{Binding HasMetadataError}" Value="True"><Setter TargetName="GridStatus" Property="Foreground" Value="{StaticResource Brush.Danger}" /></DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="DownloadListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid ClipToBounds="True">
                            <Border x:Name="ItemRoot" Padding="16" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12"><ContentPresenter /></Border>
                            <Border x:Name="MergeOverlay" Background="{StaticResource Brush.Merge}" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="SweepOverlay" Width="190" HorizontalAlignment="Left" CornerRadius="12" Opacity="0" IsHitTestVisible="False">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00F2C66D" Offset="0" /><GradientStop Color="#66F2C66D" Offset="0.5" /><GradientStop Color="#00F2C66D" Offset="1" /></LinearGradientBrush></Border.Background>
                                <Border.RenderTransform><TranslateTransform X="-220" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False" /></MultiDataTrigger.Conditions>
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False" /></MultiDataTrigger.Conditions>
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.PrimarySubtle}" />
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                <Setter TargetName="ItemRoot" Property="BorderThickness" Value="2" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsDownloadingPhase}" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.WarningSubtle}" /><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                                <DataTrigger.EnterActions><BeginStoryboard x:Name="DownloadSweep"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="SweepOverlay" Storyboard.TargetProperty="Opacity" From="0.1" To="0.75" Duration="0:0:0.7" AutoReverse="True" /><DoubleAnimation Storyboard.TargetName="SweepOverlay" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-220" To="1100" Duration="0:0:1.8" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DownloadSweep" /></DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMergingPhase}" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.MergeSubtle}" /><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Brush.Merge}" />
                                <DataTrigger.EnterActions><BeginStoryboard x:Name="MergePulse"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="MergeOverlay" Storyboard.TargetProperty="Opacity" From="0.03" To="0.28" Duration="0:0:0.65" AutoReverse="True" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="MergePulse" /></DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompletedPhase}" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.SuccessSubtle}" /><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Brush.Success}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsFailedPhase}" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Brush.DangerSubtle}" /><Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Brush.Danger}" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.QueueViewMode, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="격자">
                    <Setter Property="Width" Value="252" />
                    <Setter Property="Margin" Value="0,0,10,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{StaticResource Brush.Primary}" CornerRadius="10">
                        <TextBlock Text="G" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GMTFV" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="영상과 오디오를 간편하게 저장하세요" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SuccessPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center" />
                        <TextBlock Margin="7,0,0,0" Text="로컬 도구 준비됨" FontSize="12" Foreground="{StaticResource Brush.Success}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="14,20,14,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel IsEnabled="{Binding CanModifyQueue}">
                        <TextBlock Margin="12,0,0,8" Text="작업 공간" Style="{StaticResource NavigationLabel}" />
                        <Button Style="{StaticResource ActiveNavigationButton}">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="30" Text="▦" FontSize="17" /><TextBlock Text="다운로드 목록" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavigationButton}" Click="ChromeTabs_Click" ToolTip="Chrome 확장에서 탭을 가져옵니다">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="30" Text="◫" FontSize="17" /><TextBlock Text="Chrome 탭" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <TextBlock Margin="12,24,0,8" Text="파일 및 설정" Style="{StaticResource NavigationLabel}" />
                        <Button Style="{StaticResource NavigationButton}" Click="ImportPlaylist_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="30" Text="↥" FontSize="17" /><TextBlock Text="목록 가져오기" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavigationButton}" Click="ExportPlaylist_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="30" Text="↧" FontSize="17" /><TextBlock Text="목록 내보내기" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavigationButton}" Click="Settings_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="30" Text="⚙" FontSize="17" /><TextBlock Text="다운로드 설정" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Padding="14" Style="{StaticResource MutedCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="현재 버전" Style="{StaticResource CaptionText}" />
                                <TextBlock Margin="0,4,0,0" Text="WPF Preview" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,4" Background="{StaticResource Brush.PrimarySubtle}" CornerRadius="6" VerticalAlignment="Center">
                                <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="28,24,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="0" />
                    <RowDefinition Height="0" /><RowDefinition Height="Auto" /><RowDefinition Height="10" />
                    <RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="다운로드 목록" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,0" Text="링크를 추가하거나 대기열에 끌어놓고 작업 진행 상황을 확인하세요." Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanModifyQueue}">
                        <Button MinWidth="120" Style="{StaticResource PrimaryButton}" Click="AddLinks_Click">+ 링크 추가</Button>
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Settings_Click">⚙ 설정</Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="대기열" Style="{StaticResource SectionTitle}" />
                            <Border Margin="10,0,0,0" Padding="9,4" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="6">
                                <TextBlock Text="{Binding DownloadCountText}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox Width="100" IsEnabled="{Binding CanModifyQueue}" SelectedValue="{Binding QueueViewMode, Mode=TwoWay}" SelectedValuePath="Content" ToolTip="목록 표시 방식">
                                <ComboBoxItem Content="자세히" /><ComboBoxItem Content="단순" /><ComboBoxItem Content="격자" />
                            </ComboBox>
                            <Button Margin="8,0,0,0" IsEnabled="{Binding CanModifyQueue}" Style="{StaticResource SecondaryButton}" Click="ExportPlaylist_Click">목록 내보내기</Button>
                            <Button Margin="8,0,0,0" MinWidth="138" IsEnabled="{Binding CanModifyQueue}" Style="{StaticResource PrimaryButton}" Command="{Binding StartDownloadsCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="↓" /><TextBlock Margin="7,0,0,0" Text="{Binding DownloadActionText}" /></StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding CancelDownloadsCommand}">작업 취소</Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Padding="10" Style="{StaticResource MutedCard}" IsEnabled="{Binding CanModifyQueue}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="110" /><ColumnDefinition Width="8" /><ColumnDefinition Width="140" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="선택 항목 일괄 설정" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox x:Name="BulkTypeCombo" Grid.Column="2" SelectedIndex="0">
                                <ComboBoxItem Content="비디오" Tag="video" /><ComboBoxItem Content="오디오" Tag="audio" />
                            </ComboBox>
                            <ComboBox x:Name="BulkQualityCombo" Grid.Column="4" SelectedIndex="0">
                                <ComboBoxItem Content="최고 화질" Tag="" /><ComboBoxItem Content="2160p" Tag="2160p" /><ComboBoxItem Content="1440p" Tag="1440p" /><ComboBoxItem Content="1080p" Tag="1080p" /><ComboBoxItem Content="720p" Tag="720p" /><ComboBoxItem Content="480p" Tag="480p" />
                            </ComboBox>
                            <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Click="ApplyBulkProfile_Click">선택 항목에 적용</Button>
                            <TextBlock Grid.Column="7" Margin="12,0" Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="8" Style="{StaticResource DangerButton}" Click="DeleteSelected_Click">선택 삭제</Button>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="6" MinHeight="400" Padding="10" Style="{StaticResource Card}">
                    <Grid>
                        <ListBox x:Name="DownloadList" ItemsSource="{Binding DownloadItems}" SelectedItem="{Binding SelectedDownload, Mode=TwoWay}" SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource DownloadListItem}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="DownloadList_MouseDoubleClick"
                                 SelectionChanged="DownloadList_SelectionChanged" PreviewKeyDown="DownloadList_PreviewKeyDown" PreviewMouseDown="DownloadList_PreviewMouseDown"
                                 AllowDrop="True" DragEnter="DownloadList_DragEnter" DragOver="DownloadList_DragEnter" Drop="DownloadList_Drop">
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}">
                                    <Setter Property="ItemsPanel" Value="{StaticResource StackItemsPanel}" />
                                    <Setter Property="ItemTemplate" Value="{StaticResource DetailedItemTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueueViewMode}" Value="단순"><Setter Property="ItemTemplate" Value="{StaticResource SimpleItemTemplate}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding QueueViewMode}" Value="격자"><Setter Property="ItemsPanel" Value="{StaticResource GridItemsPanel}" /><Setter Property="ItemTemplate" Value="{StaticResource GridItemTemplate}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>
                        <StackPanel MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Width="62" Height="62" Background="{StaticResource Brush.PrimarySubtle}" CornerRadius="18" HorizontalAlignment="Center">
                                <TextBlock Text="↓" FontSize="30" Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,18,0,0" Text="다운로드할 영상을 추가해보세요" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,8,0,0" Text="링크 추가 버튼을 누르거나 YouTube 링크 여러 개를 이 영역에 끌어놓으세요."
                                       TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="8" Padding="16,13" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" /><ColumnDefinition Width="220" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center"><TextBlock Text="전체 작업" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" /></Border>
                        <ProgressBar Grid.Column="2" Height="8" Maximum="100" Value="{Binding OverallProgressPercent, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding OverallProgressText}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OverallProgressText}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
