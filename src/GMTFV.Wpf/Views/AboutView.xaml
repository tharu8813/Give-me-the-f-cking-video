<UserControl x:Class="GMTFV.Wpf.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:GMTFV.Wpf.Services" s:Motion.Enter="True">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="GMTFV" FontSize="44" FontWeight="Bold" Margin="0,8,0,0" />
  <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
  <TextBlock Text="영상과 오디오를 내 폴더에 저장하는 Windows 미디어 작업 공간입니다." Foreground="{DynamicResource MutedBrush}" LineHeight="24" Margin="0,20,0,24" TextWrapping="Wrap" />
  <Border Style="{StaticResource SettingsCard}"><StackPanel>
   <TextBlock Text="앱 업데이트" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
   <TextBlock Text="{Binding Updates.Status}" TextWrapping="Wrap" AutomationProperties.Name="업데이트 상태" />
   <ProgressBar Value="{Binding Updates.Percent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,12,0,4" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="설치 파일 다운로드 진행률" />
   <Button Content="업데이트 확인" Command="{Binding Updates.CheckCommand}" Margin="0,12,0,0" />
   <Button Content="업데이트 다운로드 및 설치" Command="{Binding Updates.InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolVisibility}}" />
   <Button Content="업데이트 취소" Command="{Binding Updates.CancelCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolVisibility}}" />
   <Button Content="릴리즈 페이지 열기" Command="{Binding OpenReleaseCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" />
   <TextBlock Text="공식 배포본의 SHA-256을 확인합니다. 설치 시 현재 설정과 목록 링크·옵션을 저장하고 앱을 종료합니다. 다음 실행에서 목록을 복원하며, 관리자 승인이 필요할 수 있습니다. 다운로드와 도구 작업을 먼저 마쳐주세요." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" />
  </StackPanel></Border>
  <TextBlock Text="GPL-3.0 · yt-dlp / FFmpeg / Deno&#10;다운로드 권한이 있는 콘텐츠에 사용하세요." Foreground="{DynamicResource MutedBrush}" LineHeight="24" Margin="0,24,0,0" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</UserControl>
