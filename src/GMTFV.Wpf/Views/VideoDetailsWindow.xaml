<Window x:Class="GMTFV.Wpf.Views.VideoDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="영상 옵션" Width="780" Height="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="영상 다운로드 옵션" FontSize="24" FontWeight="Bold"/><TextBlock Text="저장할 품질과 자막을 영상별로 조정할 수 있어요." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="128" Height="72" CornerRadius="10" Background="#26345A"><TextBlock Text="▶" Foreground="#BDB2FF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="선택한 영상 제목" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="채널 · 재생 시간 · 업로드일" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Style="{StaticResource GhostButton}" Content="링크 복사" Padding="12,7" Margin="0,0,8,0"/><Button Style="{StaticResource GhostButton}" Content="YouTube에서 열기" Padding="12,7"/></StackPanel></StackPanel></Grid></Border>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="영상 품질" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="원하는 해상도와 파일 형식을 선택하세요." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/><ComboBox SelectedIndex="0" Height="38"><ComboBoxItem Content="1080p · MP4 · 권장"/><ComboBoxItem Content="720p · MP4"/><ComboBoxItem Content="최고 화질 · WebM"/></ComboBox><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><RadioButton Content="비디오" IsChecked="True" Margin="0,0,24,0"/><RadioButton Content="오디오만"/></StackPanel></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="자막" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="자막이 필요한 경우 별도로 저장합니다." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/><ComboBox SelectedIndex="0" Height="38"><ComboBoxItem Content="자막을 저장하지 않음"/><ComboBoxItem Content="한국어"/><ComboBoxItem Content="영어"/></ComboBox><Button Style="{StaticResource SecondaryButton}" Content="자막만 다운로드" Margin="0,20,0,0" HorizontalAlignment="Left"/></StackPanel></Border></Grid>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="닫기" Margin="0,0,10,0" Click="Close_Click"/><Button Style="{StaticResource PrimaryButton}" Content="옵션 저장" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
