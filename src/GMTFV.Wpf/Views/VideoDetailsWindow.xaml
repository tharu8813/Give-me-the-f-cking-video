<Window x:Class="GMTFV.Wpf.Views.VideoDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:GMTFV.Wpf.Behaviors"
        Title="영상 상세 정보 및 다운로드 설정"
        Width="760" Height="760" MinWidth="660" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Brush.Canvas}">
    <Grid Margin="28,24,28,22" Background="{StaticResource Brush.Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Width="144" Height="96" Background="{StaticResource Brush.SurfaceMuted}" CornerRadius="12" ClipToBounds="True">
                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="영상 상세 정보" Style="{StaticResource CaptionText}" />
                <TextBlock Margin="0,5,0,0" Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ChannelName}" Foreground="{StaticResource Brush.TextSecondary}" />
                    <TextBlock Margin="9,0" Text="·" Foreground="{StaticResource Brush.BorderStrong}" />
                    <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource Brush.TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel>
                <Border Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="영상 링크" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding SourceUrl, Mode=OneWay}" IsReadOnly="True" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Click="CopyUrl_Click">링크 복사</Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="다운로드 형식 선택" Style="{StaticResource SectionTitle}" />
                                <TextBlock Margin="0,5,0,0" Text="이 영상에 적용할 타입과 실제 제공 화질을 선택하세요." Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProfileSummary}" FontSize="11" Foreground="{StaticResource Brush.Primary}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="다운로드 타입" Style="{StaticResource CaptionText}" />
                                <ComboBox x:Name="DownloadTypeCombo" Margin="0,6,0,0" DisplayMemberPath="DisplayName" SelectionChanged="DownloadType_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="화질" Style="{StaticResource CaptionText}" />
                                <ComboBox x:Name="QualityCombo" Margin="0,6,0,0" DisplayMemberPath="DisplayText" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="파일 형식" Style="{StaticResource CaptionText}" />
                                <ComboBox x:Name="ContainerCombo" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,15,0,0">
                            <TextBlock x:Name="ProfileStatus" Text="변경한 설정은 아래 버튼을 누르면 목록에 즉시 반영됩니다." Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="ApplyProfile_Click">선택 설정 적용</Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="자막" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SubtitleStatus" Margin="0,5,0,0" Text="제공 자막과 자동 생성 자막을 조회할 수 있습니다." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="LoadSubtitles_Click">자막 조회</Button>
                        </Grid>
                        <ListBox x:Name="SubtitleList" Margin="0,14,0,10" MinHeight="80" MaxHeight="150" DisplayMemberPath="DisplayName"
                                 VirtualizingPanel.ScrollUnit="Pixel" behaviors:SmoothScrollBehavior.IsEnabled="True" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="DownloadSubtitle_Click">선택 자막 저장</Button>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="16" Style="{StaticResource MutedCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StatusPill}" VerticalAlignment="Top"><TextBlock Text="현재 상태" FontSize="11" Foreground="{StaticResource Brush.Primary}" /></Border>
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <TextBlock Text="다운로드 설정과 진행 상태는 이 창을 닫아도 유지됩니다." VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
            <Button HorizontalAlignment="Right" MinWidth="96" Style="{StaticResource PrimaryButton}" Click="Close_Click">닫기</Button>
        </Grid>
    </Grid>
</Window>
