<UserControl x:Class="GMTFV.Wpf.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:GMTFV.Wpf.Services" s:Motion.Enter="True">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,8,8">
   <TextBlock Text="다운로드 준비" FontSize="{StaticResource DisplaySize}" FontWeight="SemiBold" Margin="0,0,0,8" />
   <TextBlock Text="필요한 준비는 앱에 맡기세요." Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,0,0,22" />
   <Border Background="{DynamicResource InputBrush}" CornerRadius="12" Padding="20">
    <StackPanel>
     <TextBlock Text="{Binding Tools.StateLabel}" FontSize="12" FontWeight="SemiBold">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers>
       <DataTrigger Binding="{Binding Tools.Missing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
       <DataTrigger Binding="{Binding Tools.IsReady}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <TextBlock Text="{Binding Tools.Status}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="29" Margin="0,10,0,10" AutomationProperties.LiveSetting="Polite" />
     <TextBlock Text="{Binding Tools.Guidance}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" />
     <StackPanel Visibility="{Binding Tools.IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0">
      <ProgressBar Value="{Binding Tools.Progress, Mode=OneWay}" IsIndeterminate="{Binding Tools.IsIndeterminate}" Height="4" AutomationProperties.Name="현재 받는 파일의 진행률" />
      <TextBlock Text="{Binding Tools.Activity}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Tools.IsPreparing, Converter={StaticResource BoolVisibility}}" />
      <TextBlock Text="진행률은 현재 받는 파일 기준입니다." Style="{StaticResource Caption}" Margin="0,5,0,0" Visibility="{Binding Tools.IsPreparing, Converter={StaticResource BoolVisibility}}" />
     </StackPanel>
     <Button Content="{Binding Tools.InstallLabel}" Command="{Binding InstallToolsCommand}" Margin="0,18,0,0">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding Tools.IsReady}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
       <DataTrigger Binding="{Binding Tools.IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="영상 링크 추가하러 가기" Command="{Binding PanelCommand}" CommandParameter="" Style="{StaticResource PrimaryButton}" Visibility="{Binding Tools.IsReady, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0" />
     <Button Content="준비 취소" Command="{Binding CancelToolSetupCommand}" Visibility="{Binding Tools.IsPreparing, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0" />
     <Button Content="준비 상태 다시 확인" Command="{Binding CheckToolsCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" />
     <TextBlock Text="자동 설치에는 인터넷 연결과 약 1GB의 여유 공간이 필요합니다." TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding Tools.IsReady}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Border>
   <TextBlock Text="기능별 준비 상태" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
   <ItemsControl ItemsSource="{Binding Tools.Components}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Purpose}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
       <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers>
         <DataTrigger Binding="{Binding Ready}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
         <DataTrigger Binding="{Binding Ready}" Value="False"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="다운로드가 잘 안 되나요?" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
   <TextBlock Text="인터넷 연결과 영상 주소를 먼저 확인해 주세요. 특정 영상만 실패한다면, 앱 밖에서 해당 영상을 재생할 수 있는지도 확인해 보세요." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="22" />
   <Expander Header="문제가 계속된다면" Margin="0,14,0,0" HorizontalContentAlignment="Stretch">
    <StackPanel Margin="0,10,0,0">
     <TextBlock Text="여러 영상에서 같은 오류가 나면 도구를 새로 받아 보세요. 준비하는 동안 다운로드 작업을 마쳐 주세요." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" />
     <Button Content="도구 새로 받기" Command="{Binding InstallToolsCommand}" Margin="0,12,0,0" />
     <TextBlock Text="도움이 필요할 때는 문제 해결 기록에서 오류 내용을 확인할 수 있습니다." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,8" />
     <Button Content="문제 해결 기록 열기" Command="{Binding OpenLogsCommand}" />
    </StackPanel>
   </Expander>
   <Expander Header="설치 위치 및 자세한 정보" Margin="0,14,0,0" HorizontalContentAlignment="Stretch">
    <StackPanel Margin="0,10,0,0">
     <TextBlock Text="설치 위치" Style="{StaticResource Label}" />
     <TextBox Text="{Binding Settings.ToolFolder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="현재 도구 설치 위치" />
     <Button Content="기존 도구 폴더 사용…" Command="{Binding ChooseToolsCommand}" Margin="0,8,0,0" />
     <TextBlock Text="도구를 직접 설치한 경우에만 선택하세요. 변경한 위치는 설정에서 저장할 수 있습니다." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,12" />
     <TextBlock Text="공식 배포처에서 받은 파일의 무결성과 실행 상태를 확인한 뒤 사용합니다." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,12" />
     <TextBox Text="{Binding Tools.Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0" AutomationProperties.Name="도구 검사 상세 정보" />
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</UserControl>
