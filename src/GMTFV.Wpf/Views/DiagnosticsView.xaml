<UserControl x:Class="GMTFV.Wpf.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:GMTFV.Wpf.Services" s:Motion.Enter="True">
 <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="준비된 도구, 확실한 다운로드." Style="{StaticResource SectionTitle}" Margin="0,0,0,12" /><TextBlock Text="설치된 도구의 버전과 누락 여부를 확인하세요.&#10;진단 로그는 안정판과 별도로 기록됩니다." Style="{StaticResource Caption}" LineHeight="22" Margin="0,0,0,20" /><Button Content="도구 버전 확인" Style="{StaticResource PrimaryButton}" Command="{Binding CheckToolsCommand}" /><Button Content="진단 로그 열기" Command="{Binding OpenLogsCommand}" Margin="0,8,0,16" /></StackPanel><ScrollViewer><TextBox Text="{Binding ToolReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" BorderThickness="0" /></ScrollViewer></DockPanel>
</UserControl>
