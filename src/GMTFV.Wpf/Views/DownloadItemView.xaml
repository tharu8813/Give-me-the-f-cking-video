<UserControl x:Class="GMTFV.Wpf.Views.DownloadItemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:GMTFV.Wpf.Services" xmlns:local="clr-namespace:GMTFV.Wpf.Views" xmlns:core="clr-namespace:GMTFV.Core;assembly=GMTFV.Core" s:Motion.Present="{Binding IsRemoving, Converter={StaticResource Inverse}}">
 <Border x:Name="Row" Padding="{StaticResource RowPadding}" CornerRadius="{StaticResource CardRadius}">
  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger></Style.Triggers></Style></Border.Style>
  <DockPanel>
   <TextBlock Text="{Binding QueueNumber, StringFormat={}{0:D2}}" Width="36" Margin="0,2,8,0" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="{Binding QueueNumber, StringFormat=목록 순서 {0}}" />
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="148" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource InputBrush}" Height="84" VerticalAlignment="Top" CornerRadius="8" ClipToBounds="True">
    <Grid>
     <Path Data="{StaticResource Icon.Play}" Width="22" Height="24" Stretch="Uniform" Stroke="{DynamicResource DisabledBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
     <Image Source="{Binding Thumbnail, Converter={StaticResource Thumbnail}, NotifyOnTargetUpdated=True}" TargetUpdated="ThumbnailChanged" s:Motion.Kind="Modal" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" ImageFailed="ThumbnailFailed" />
     <Border Style="{StaticResource Skeleton}" s:Motion.Present="{Binding IsMetadata}" />
     <Border Background="#E6191917" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Padding="5,2"><TextBlock Text="{Binding Duration}" FontFamily="{StaticResource MonoFont}" FontSize="10" /></Border>
    </Grid>
   </Border>
   <Grid Grid.Column="2" Margin="0,0,20,0">
    <Grid.RowDefinitions><RowDefinition Height="21" /><RowDefinition Height="19" /><RowDefinition Height="23" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
    <TextBlock Grid.Row="1" Text="{Binding Channel}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
    <Button Grid.Row="2" Content="{Binding Selection}" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" MinHeight="22" Padding="0,2" FontSize="11" ToolTip="형식·해상도·FPS와 기본값 상속 수정" />
    <Grid Grid.Row="3" VerticalAlignment="Bottom">
     <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
     <TextBlock Text="{Binding OutputPath}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" Visibility="{Binding HasOutput, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource PanelBrush}" />
    </Grid>
   </Grid>
   <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0">
    <Grid><TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:DownloadState.Downloading}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:DownloadState.Completed}"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="{x:Static core:DownloadState.Failed}"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
     </Style.Triggers></Style></TextBlock.Style>
    </TextBlock></Grid>
    <local:DownloadJourney Phase="{Binding Phase}" Failed="{Binding HasError}" Margin="0,8,0,2" ToolTip="정보 확인 → 준비 → 다운로드 → 후처리 → 완료" />
    <Grid><ProgressBar s:Motion.Progress="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,6,0,0" Height="2" AutomationProperties.Name="개별 다운로드 진행률" /><TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Background="{DynamicResource PanelBrush}" HorizontalAlignment="Right" /></Grid>
   </StackPanel>
   <StackPanel Grid.Column="4" VerticalAlignment="Center">
    <Button Content="옵션 · 자막" Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="6,4" MinHeight="32" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button ToolTip="다시 시도" AutomationProperties.Name="다시 시도" Style="{StaticResource IconButton}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource Icon.Retry}" Style="{StaticResource VectorIcon}" /></Button>
     <Button ToolTip="이 항목 취소" AutomationProperties.Name="이 항목 취소" Style="{StaticResource IconButton}" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource Icon.Stop}" Style="{StaticResource VectorIcon}" /></Button>
     <Button ToolTip="문제 해결" AutomationProperties.Name="실패 상세" Style="{StaticResource IconButton}" Foreground="{DynamicResource ErrorBrush}" Command="{Binding DataContext.FailureCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><Path Data="{StaticResource Icon.Warning}" Style="{StaticResource VectorIcon}" /></Button>
     <Button ToolTip="목록에서 제거 · 파일 유지" AutomationProperties.Name="목록에서 제거" Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4,0,0,0"><Path Data="{StaticResource Icon.Close}" Style="{StaticResource VectorIcon}" /></Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding HasOutput, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Right"><Button ToolTip="저장 파일 열기" AutomationProperties.Name="저장 파일 열기" Style="{StaticResource IconButton}" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Path Data="{StaticResource Icon.Play}" Style="{StaticResource VectorIcon}" /></Button><Button ToolTip="폴더에서 파일 확인" AutomationProperties.Name="폴더에서 파일 확인" Style="{StaticResource IconButton}" Command="{Binding DataContext.RevealFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4,0,0,0"><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource VectorIcon}" /></Button></StackPanel>
   </StackPanel>
  </Grid>
  </DockPanel>
 </Border>
</UserControl>
