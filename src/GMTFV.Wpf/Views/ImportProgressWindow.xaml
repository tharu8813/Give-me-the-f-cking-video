<Window x:Class="GMTFV.Wpf.Views.ImportProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="목록 가져오기" Width="510" Height="315" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="SingleBorderWindow">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="목록을 준비하고 있어요" FontSize="22" FontWeight="Bold"/><TextBlock Text="영상 정보를 확인해 다운로드 큐에 추가합니다." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><StackPanel><DockPanel><TextBlock Text="영상 정보 분석 중" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="0 / 0" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"/></DockPanel><ProgressBar x:Name="ImportProgress" Height="7" Margin="0,14,0,10" Maximum="100" Value="42"/><TextBlock x:Name="CurrentItemText" Text="다음 항목을 준비하는 중…" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
        <TextBlock Grid.Row="4" Text="이 창을 닫지 않아도 백그라운드에서 계속 진행됩니다." Foreground="{StaticResource MutedBrush}"/>
        <Button Grid.Row="6" Style="{StaticResource GhostButton}" Content="가져오기 취소" HorizontalAlignment="Right" Click="Cancel_Click"/>
    </Grid>
</Window>
