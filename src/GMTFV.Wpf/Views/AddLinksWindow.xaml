<Window x:Class="GMTFV.Wpf.Views.AddLinksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube 링크 추가" Width="620" Height="470" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Brush.Canvas}">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="YouTube 링크 추가" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Text="한 줄에 하나씩 입력하거나 여러 링크를 한 번에 붙여넣을 수 있습니다." Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="Paste_Click">붙여넣기</Button>
        </Grid>

        <Border Grid.Row="2" Padding="16" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="추가할 링크" Style="{StaticResource SectionTitle}" />
                <TextBox x:Name="LinksTextBox" Grid.Row="2" Style="{StaticResource InputBox}" Height="Auto" MinHeight="190"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         Padding="13,11" SpellCheck.IsEnabled="False" />
                <TextBlock x:Name="ValidationText" Grid.Row="4" Text="YouTube 영상 주소만 목록에 추가됩니다." Style="{StaticResource CaptionText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="Clear_Click">내용 지우기</Button>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click">취소</Button>
                <Button Margin="8,0,0,0" MinWidth="130" Style="{StaticResource PrimaryButton}" Click="Add_Click">목록에 추가</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
