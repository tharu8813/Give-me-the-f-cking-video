<Window x:Class="GMTFV.Wpf.Views.AddVideoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="새 영상 추가" Width="560" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="새 영상을 추가할까요?" FontSize="24" FontWeight="Bold"/><TextBlock Text="YouTube 링크를 붙여넣으면 영상 정보를 확인해 다운로드 큐에 넣습니다." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="2"><TextBlock Text="YOUTUBE URL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/><TextBox x:Name="UrlTextBox" Height="44" VerticalContentAlignment="Center" Text="https://"/></StackPanel>
        <TextBlock Grid.Row="3" Text="팁  ·  Ctrl+V로 주소를 붙여넣고 Enter를 누르면 바로 추가할 수 있어요." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="취소" Margin="0,0,10,0" Click="Cancel_Click"/><Button Style="{StaticResource PrimaryButton}" Content="큐에 추가  →" IsDefault="True" Click="Add_Click"/></StackPanel>
    </Grid>
</Window>
