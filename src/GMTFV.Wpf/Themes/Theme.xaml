<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cv="clr-namespace:GMTFV.Wpf.Converters">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Colors.xaml" /><ResourceDictionary Source="Typography.xaml" /><ResourceDictionary Source="Spacing.xaml" /><ResourceDictionary Source="Icons.xaml" /><ResourceDictionary Source="Controls.xaml" /><ResourceDictionary Source="Animations.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" /><cv:HasValueConverter x:Key="HasValue" /><cv:InverseBooleanConverter x:Key="Inverse" /><cv:ThumbnailConverter x:Key="Thumbnail" />
  <cv:QualityLabelConverter x:Key="QualityLabel" />
  <cv:HasSelectionConverter x:Key="HasSelection" />
  <cv:ModeRadioConverter x:Key="ModeRadio" />
  <DataTemplate x:Key="FormatTemplate"><TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis" /></DataTemplate>
  <DataTemplate x:Key="QualityTemplate"><TextBlock Text="{Binding Converter={StaticResource QualityLabel}}" /></DataTemplate>
</ResourceDictionary>
