<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:Double x:Key="BodySize">13</sys:Double><sys:Double x:Key="CaptionSize">12</sys:Double><sys:Double x:Key="TitleSize">20</sys:Double><sys:Double x:Key="DisplaySize">26</sys:Double>
  <FontFamily x:Key="BodyFont">Segoe UI, Malgun Gothic</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="{StaticResource BodySize}" /></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{StaticResource TitleSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="{StaticResource CaptionSize}" /><Setter Property="Margin" Value="0,12,0,8" /></Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="{StaticResource CaptionSize}" /></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontSize" Value="11" /></Style>
</ResourceDictionary>
