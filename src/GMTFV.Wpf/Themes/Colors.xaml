<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Canvas">#FF0B1120</Color>
    <Color x:Key="Color.Surface">#FF121B2D</Color>
    <Color x:Key="Color.SurfaceMuted">#FF19253A</Color>
    <Color x:Key="Color.Border">#FF26344D</Color>
    <Color x:Key="Color.BorderStrong">#FF3A4964</Color>
    <Color x:Key="Color.TextPrimary">#FFF2F5FA</Color>
    <Color x:Key="Color.TextSecondary">#FFA3AFC2</Color>
    <Color x:Key="Color.Primary">#FF7192FF</Color>
    <Color x:Key="Color.PrimaryHover">#FF89A4FF</Color>
    <Color x:Key="Color.PrimarySubtle">#FF202F57</Color>
    <Color x:Key="Color.Success">#FF55D6A5</Color>
    <Color x:Key="Color.SuccessSubtle">#FF173A32</Color>
    <Color x:Key="Color.Warning">#FFF2C66D</Color>
    <Color x:Key="Color.WarningSubtle">#FF3D3521</Color>
    <Color x:Key="Color.Merge">#FFFF9D57</Color>
    <Color x:Key="Color.MergeSubtle">#FF432B20</Color>
    <Color x:Key="Color.Danger">#FFFF858B</Color>
    <Color x:Key="Color.DangerSubtle">#FF40242D</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimarySubtle" Color="{StaticResource Color.PrimarySubtle}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="{StaticResource Color.SuccessSubtle}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="{StaticResource Color.WarningSubtle}" />
    <SolidColorBrush x:Key="Brush.Merge" Color="{StaticResource Color.Merge}" />
    <SolidColorBrush x:Key="Brush.MergeSubtle" Color="{StaticResource Color.MergeSubtle}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{StaticResource Color.DangerSubtle}" />
</ResourceDictionary>
