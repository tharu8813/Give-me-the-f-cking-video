<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0-windows</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <OutputPath Condition="'$(UseArtifactsOutput)' != 'true'">bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' == 'net472'">false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\GMTFV.Core\GMTFV.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="Newtonsoft.Json"><HintPath>..\..\packages\Newtonsoft.Json.13.0.4\lib\net45\Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'"><PackageReference Include="Newtonsoft.Json" Version="13.0.4" /></ItemGroup>
</Project>
